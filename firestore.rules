rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Server-Side Cryptographic Admin Identity:
    // Bound to the platform owner's Firebase Authentication UID or Firebase Auth custom claim 'admin: true'
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == "6oo1oPvtLZZ93Sry6jbcDuvIuPG3" ||
        request.auth.token.admin == true
      );
    }

    // User Profile Documents
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Public Contributor Profiles
    match /contributors/{contributorId} {
      // Anyone can view approved profiles; admins and profile owners can view any status
      allow read: if resource.data.status == "approved" || isAdmin() || isOwner(contributorId);
      
      // ONLY Admin can create a new contributor profile (activating contributor status)
      allow create: if isAdmin();
      
      // An approved contributor can edit their own profile fields (bio, title, links),
      // but CANNOT change their status, email, or uid; Admin can update any field
      allow update: if isAdmin() || (
        isOwner(contributorId) &&
        resource.data.status == "approved" &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.uid == resource.data.uid
      );
      
      // ONLY Admin can delete a contributor profile
      allow delete: if isAdmin();
    }

    // Contributor Article Drafts & Submissions
    match /contributor_articles/{articleId} {
      // Anyone can read published articles; authors and admins can read drafts, submissions, and feedback
      allow read: if resource.data.status == "published" ||
                     (isAuthenticated() && (request.auth.uid == resource.data.authorUid || isAdmin()));

      // Authors can create drafts or submit articles (cannot create directly with status 'published')
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.authorUid &&
                       (request.resource.data.status == "draft" || request.resource.data.status == "submitted");

      // Authors can update their own drafts or resubmit changes-requested articles.
      // Contributors CANNOT set status to 'published' and cannot edit published articles directly.
      // ONLY Admin can set status to 'published', 'changes_requested', or 'rejected'.
      allow update: if isAdmin() || (
                       isAuthenticated() &&
                       request.auth.uid == resource.data.authorUid &&
                       request.resource.data.authorUid == resource.data.authorUid &&
                       request.resource.data.status != "published" &&
                       (request.resource.data.status == "draft" || request.resource.data.status == "submitted") &&
                       (resource.data.status == "draft" || resource.data.status == "changes_requested" || resource.data.status == "submitted")
                     );

      // Authors can delete their own unpublished drafts; admins can delete any
      allow delete: if isAuthenticated() && (
                       (request.auth.uid == resource.data.authorUid && resource.data.status == "draft") ||
                       isAdmin()
                     );
    }

    // Article Views & Stats Tracking
    match /article_stats/{slug} {
      allow read: if true;
      allow create, update: if true;
    }

    // Contributor Applications
    match /contributor_applications/{appId} {
      // Prospective authors (including guests) can submit an application with initial status PENDING
      allow create: if request.resource.data.status == "PENDING" || request.resource.data.status == "APPLICANT";
      
      // Only Admin and the applicant can read the application
      allow read: if isAdmin() || (isAuthenticated() && (request.auth.uid == resource.data.userId || isOwner(appId)));
      
      // ONLY Admin can update application status (e.g. approve or reject)
      allow update: if isAdmin();
      
      // ONLY Admin can delete an application
      allow delete: if isAdmin();
    }

    // Article Submissions ("Write for Rvan.me")
    match /article_submissions/{submissionId} {
      // Any visitor (even unauthenticated) can submit an article idea or finished draft with initial status PENDING
      allow create: if request.resource.data.status == "PENDING" &&
                       request.resource.data.originalWorkConfirmed == true &&
                       request.resource.data.fullName is string &&
                       request.resource.data.email is string &&
                       request.resource.data.title is string &&
                       request.resource.data.submissionType in ["idea", "article"];

      // Private submission data -> ONLY Admin can read
      allow read: if isAdmin();

      // ONLY Admin can update review notes, request changes, reject, or publish
      allow update: if isAdmin();

      // ONLY Admin can delete
      allow delete: if isAdmin();
    }
  }
}
